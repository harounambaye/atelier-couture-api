# Copier ce fichier en .env puis remplacer les valeurs

# --- PostgreSQL (lu par docker-compose) ---
POSTGRES_USER=atelier
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=atelier

# --- Connexion de l'API à la base ---
DATABASE_URL=postgresql+psycopg://atelier:changez_moi@localhost:5432/atelier


# --- Sécurité JWT ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez_moi
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Premier administrateur (python -m app.seed) ---
ADMIN_EMAIL=admin@atelier.sn
ADMIN_TELEPHONE=770000000
ADMIN_NOM_COMPLET=Patron Atelier
ADMIN_MOT_DE_PASSE=changez_moi